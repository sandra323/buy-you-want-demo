# Mobile API base URL (Expo inlines EXPO_PUBLIC_* at bundle time).
# iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: LAN IP (e.g. http://192.168.1.10:3000) or an HTTPS tunnel.
# Development Dev Client allows cleartext HTTP (iOS ATS / Android usesCleartextTraffic).
