# Copy to `.env` for local development: `cp .env.example .env`
# Never commit `.env` — secrets stay local and in CI secret stores.

# --- API (Docker Compose + local NestJS) ---

# HS256 signing key; must be >= 32 bytes. Rotating invalidates all access tokens.
JWT_SECRET=change-me-to-at-least-32-bytes-long-secret

# Access token lifetime (default 30m for demo refresh flows; 2h is env-only).
JWT_ACCESS_TTL=30m

# Refresh token lifetime stored as expires_at on insert.
JWT_REFRESH_TTL=30d

# Unpaid order auto-cancel TTL (seconds). Product default 60; raise to 300 for live demos only.
ORDER_PAY_TIMEOUT_SEC=60

# Paid order auto-complete TTL (seconds). Default 10 minutes.
ORDER_COMPLETE_AFTER_SEC=600

# MySQL connection string. Compose overrides host to `mysql` inside the API container.
# Local NestJS against Compose MySQL: mysql://lightbuy:lightbuy@localhost:3306/lightbuy
DATABASE_URL=mysql://lightbuy:lightbuy@localhost:3306/lightbuy

# Schema sync is OFF by default. Set TYPEORM_SYNC=1 only with NODE_ENV=development for local experiments.
# Never enable in CI/prod — use migrations (`pnpm --filter api migration:run`).
# TYPEORM_SYNC=1

# Sentry (API). Leave empty to disable in local dev.
SENTRY_DSN=
SENTRY_RELEASE=local-dev

# Run demo seed on API container boot (user 13800000000 / password123 — wired in M2).
SEED_ON_BOOT=1

# Host port published by Docker Compose (container internal port is always 3000).
PORT=3000

# --- Mobile (Expo inlines EXPO_PUBLIC_* at bundle time) ---

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# API base URL — pick one target per run:
# iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: LAN IP (e.g. http://192.168.1.10:3000) or an HTTPS tunnel.
# Development Dev Client allows cleartext HTTP (iOS ATS / Android usesCleartextTraffic).

# --- Docker Compose MySQL (optional overrides) ---

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=lightbuy

# Official Hub (`node:20-alpine`, `mysql:8.4`) needs auth.docker.io.
# app.docker.com working does not mean Hub registry works (often DNS pollution).
# If compose times out fetching an anonymous token, use a mirror:
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
NODE_IMAGE=node:20-alpine
MYSQL_IMAGE=mysql:8.4
