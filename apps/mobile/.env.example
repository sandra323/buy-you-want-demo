# Copy to `.env` in this package (`apps/mobile/.env`). Expo inlines EXPO_PUBLIC_* at bundle time.
# Never commit `.env`.

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_APP_ENV=development
# Development is no-op by default. Set exactly 1 only while verifying wiring.
EXPO_PUBLIC_TELEMETRY_IN_DEV=0

# iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator (loopback of the host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical device: LAN IP (e.g. http://192.168.1.10:3000) or an HTTPS tunnel.
# Development Dev Client allows cleartext HTTP (iOS ATS / Android usesCleartextTraffic).
